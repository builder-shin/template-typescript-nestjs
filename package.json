{
  "name": "template-typescript-nestjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Production-ready NestJS JSON:API template",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/config/main.js",
    "worker": "node dist/app/jobs/worker.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:quick": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=false",
    "test:jsonapi": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=false test/jsonapi",
    "test:controllers": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=false test/controllers",
    "test:db": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=false test/integration test/db test/models",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "check": "./scripts/check.sh",
    "migrate": "typeorm migration:run -d dist/config/data-source.js",
    "seed": "node dist/db/seeds.js",
    "db:up": "docker compose up -d --wait db",
    "compose:verify": "docker compose config --quiet",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/tr46": "^5.0.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.0",
    "@nestjs/typeorm": "12.0.1",
    "argon2": "0.45.1",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "5.11.1",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "tr46": "6.0.0",
    "typeorm": "1.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "secretlint"
    ]
  }
}
