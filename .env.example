# 애플리케이션이 listen하는 포트입니다. Compose는 호스트에도 같은 포트를 게시하고
# 컨테이너 헬스체크도 이 값을 따릅니다.
PORT=4000

# PostgreSQL Compose 자격 증명입니다. 개발 전용 값입니다.
POSTGRES_DB=nestjs_template
POSTGRES_USER=nestjs
POSTGRES_PASSWORD=nestjs

# access/refresh token 서명 키입니다. UTF-8 최소 32바이트가 필수입니다. 아래 값은
# 명백한 더미이고, 운영 환경에서는 절대 이 값을 쓰면 안 됩니다 — 반드시 자체 생성한
# 무작위 값으로 바꾸세요.
JWT_SECRET_KEY=dev-only-insecure-jwt-secret-do-not-use-in-prod

# 아래는 전부 선택이며, 비우면 스펙 12장의 기본값을 씁니다.
# JWT_ISSUER=template-typescript-nestjs
# JWT_AUDIENCE=template-typescript-nestjs
# JWT_ACCESS_EXPIRES_SECONDS=900
# JWT_REFRESH_EXPIRES_SECONDS=2592000
# JWT_LEEWAY_SECONDS=0

# 아래 둘은 워커(`pnpm worker`) 전용 환경 변수입니다 — API 프로세스는 읽지 않으므로,
# API만 띄운다면 Redis가 없어도 됩니다.

# 워커가 붙을 Redis입니다. 필수(기본값 없음). 아래 값은 로컬 개발용 예시이고,
# 운영에서는 실제 Redis 엔드포인트로 바꿔야 합니다.
REDIS_URL=redis://localhost:6379

# 선택이며, 비우면 스펙 12장의 기본값(604800초 = 7일)을 씁니다. 음수는 거부됩니다.
# REFRESH_SESSION_RETENTION_SECONDS=604800
